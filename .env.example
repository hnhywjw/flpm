# 数据库文件路径（可选，默认 db/app.db）
# DB_PATH=./db/app.db

# 端口（默认 3000）
# PORT=3000

# 时区：应用依赖 SQLite 的 localtime，必须设置
# 容器默认 UTC，不设会让所有时间差 8 小时
TZ=Asia/Shanghai

# 定时任务鉴权。部署前必须改成随机长字符串，不要用示例值。
JOB_TOKEN=please-change-this-job-token

# 新建用户 / 重置密码的初始密码。至少 9 位，部署前必须改掉。
DEFAULT_PWD=ChangeMe@2026

# 验证码签名（可选）。不配则进程内随机，重启后旧验证码失效。
# CAPTCHA_SECRET=
