{
  "compilerOptions": {
    "outDir": ".test-build",
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "node",
    "target": "ES2022",
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["lib/domain.ts"],
  "exclude": ["node_modules", ".next"]
}
